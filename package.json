{
	"name": "h5p-server",
	"version": "1.0.0",
	"main": "index.js",
	"scripts": {
		"build": "nest build",
		"format": "prettier --write \"src/**/*.ts\"",
		"start:h5p": "nest start h5p-editor",
		"start:h5p:dev": "nest start h5p-editor --debug --watch",
		"start:h5p:prod": "node dist/apps/h5p-editor.app",
		"start:h5p:consumer": "nest start h5p-editor-consumer",
		"start:h5p:consumer:prod": "node dist/apps/h5p-editor-consumer.app",
		"start:h5p:library-management": "nest start h5p-library-management",
		"start:h5p:library-management:dev": "nest start h5p-library-management --debug --watch",
		"start:h5p:library-management:prod": "node dist/apps/h5p-library-management.app",
		"lint": "eslint \"{src,apps,libs,test}/**/*.ts\"",
		"test": "jest",
		"test:watch": "jest --watch",
		"test:cov": "jest --coverage",
		"test:debug": "node --inspect-brk -r tsconfig-paths/register -r ts-node/register node_modules/.bin/jest --runInBand",
		"pregenerate-client:authorization-api": "rimraf ./src/infra/authorization-client/authorization-api-client",
		"generate-client:authorization-api": "openapi-generator-cli generate -c ./openapitools.json --generator-key authorization-api",
		"h5p:build": "rimraf --glob \"scripts/h5p/**/*.js\" \"scripts/h5p/**/*.js.map\" && swc scripts/h5p -d .",
		"h5p:package-h5p-libraries": "npm run h5p:build && dotenv -- node ./scripts/h5p/package-h5p-libraries.js",
		"h5p:update-h5p-map": "npm run h5p:build && dotenv -- node ./scripts/h5p/update-h5p-map.js",
		"h5p:upload-h5p-libraries": "npm run h5p:build && dotenv -- node ./scripts/h5p/upload-h5p-libraries.js"
	},
	"repository": {
		"type": "git",
		"url": "git+https://github.com/hpi-schul-cloud/h5p-server.git"
	},
	"engines": {
		"node": "24",
		"npm": ">=9"
	},
	"keywords": [
		"h5p"
	],
	"author": "Schulcloud-Verbund",
	"license": "AGPL-3.0",
	"bugs": {
		"url": "https://github.com/hpi-schul-cloud/h5p-server/issues"
	},
	"homepage": "https://github.com/hpi-schul-cloud/h5p-server#readme",
	"description": "A server for hosting H5P content, providing an API for content management and delivery.",
	"overrides": {
		"underscore": "1.13.8"
	},
	"dependencies": {
		"@aws-sdk/client-s3": "^3.1021.0",
		"@aws-sdk/lib-storage": "^3.1021.0",
		"@aws-sdk/util-retry": "^3.374.0",
		"@golevelup/nestjs-rabbitmq": "^9.0.0",
		"@keyv/mongo": "^3.1.0",
		"@lumieducation/h5p-server": "^10.0.4",
		"@lumieducation/h5p-svg-sanitizer": "^10.0.4",
		"@mikro-orm/core": "^6.6.11",
		"@mikro-orm/mongodb": "^6.6.11",
		"@mikro-orm/nestjs": "^6.1.2",
		"@nestjs/axios": "^4.0.1",
		"@nestjs/common": "^11.1.18",
		"@nestjs/config": "^4.0.3",
		"@nestjs/core": "^11.1.18",
		"@nestjs/passport": "^11.0.5",
		"@nestjs/platform-express": "^11.1.18",
		"@nestjs/swagger": "^11.2.6",
		"@smithy/node-http-handler": "^4.7.1",
		"@types/amqplib": "^0.10.8",
		"@types/multer": "^1.4.12",
		"adm-zip": "^0.5.17",
		"amqplib": "^1.0.3",
		"axios": "^1.15.0",
		"cache-manager": "^7.2.8",
		"class-transformer": "^0.5.1",
		"class-validator": "^0.14.3",
		"cookie": "^1.1.1",
		"i18next": "^24.2.3",
		"i18next-fs-backend": "^2.6.0",
		"jsonwebtoken": "^9.0.3",
		"keyv": "^5.6.0",
		"load-esm": "^1.0.3",
		"mime": "^4.1.0",
		"nest-winston": "^1.10.2",
		"passport-headerapikey": "^1.2.2",
		"passport-jwt": "^4.0.1",
		"prom-client": "^15.1.3",
		"reflect-metadata": "^0.2.2",
		"response-time": "^2.3.4",
		"rxjs": "^7.8.2",
		"winston": "^3.19.0",
		"yaml": "^2.8.3"
	},
	"devDependencies": {
		"@eslint/eslintrc": "^3.3.5",
		"@eslint/js": "^10.0.1",
		"@golevelup/ts-jest": "^3.0.0",
		"@jest/globals": "^30.3.0",
		"@nestjs/cli": "^11.0.17",
		"@nestjs/schematics": "^11.0.10",
		"@nestjs/testing": "^11.1.17",
		"@openapitools/openapi-generator-cli": "^2.31.0",
		"@swc/cli": "^0.8.1",
		"@swc/core": "^1.15.21",
		"@swc/jest": "^0.2.39",
		"@types/express": "^5.0.6",
		"@types/jest": "^30.0.0",
		"@types/jsonwebtoken": "^9.0.10",
		"@types/mock-fs": "^4.13.4",
		"@types/node": "^22.15.23",
		"@types/passport-jwt": "^4.0.1",
		"@types/response-time": "^2.3.9",
		"@types/source-map-support": "^0.5.10",
		"@types/supertest": "^7.2.0",
		"dotenv-cli": "^11.0.0",
		"eslint": "^10.1.0",
		"eslint-config-prettier": "^10.1.8",
		"eslint-plugin-jest": "^29.15.2",
		"eslint-plugin-prettier": "^5.5.5",
		"fishery": "^2.4.0",
		"globals": "^17.4.0",
		"jest": "^30.3.0",
		"mock-fs": "^5.5.0",
		"mongodb-memory-server-global": "^11.0.1",
		"prettier": "^3.8.1",
		"rimraf": "^6.1.3",
		"source-map-support": "^0.5.21",
		"supertest": "^7.2.2",
		"ts-jest": "^29.4.6",
		"ts-loader": "^9.5.4",
		"ts-node": "^10.9.2",
		"typescript": "^5.9.3",
		"typescript-eslint": "^8.58.0"
	}
}
