# Use Debian "builder" for build stage
FROM docker.io/debian:bullseye AS builder

# Install git and curl for better connectivity testing
RUN apt-get update && \
    apt-get --no-install-recommends install -y git curl ca-certificates && \
    rm -rf /var/lib/apt/lists/*

# the last used version from Lumi
ENV LAST_USED_H5P_LIBRARY=b5f527e140c17da2792283d369f621e9b3f969ff
ENV LAST_USED_H5P_EDITOR_LIBRARY=f3a60ec2bdbe410cb2b11e8f8cb4cf206c41364b

# Test connectivity and clone H5P repositories with better error handling
RUN curl -fsSL https://api.github.com/repos/h5p/h5p-php-library > /dev/null && \
    curl -fsSL https://api.github.com/repos/h5p/h5p-editor-php-library > /dev/null && \
    echo "GitHub connectivity verified"

# Clone H5P repositories with explicit error handling
RUN git clone --depth=1 https://github.com/h5p/h5p-php-library.git h5p-php-library || \
    { echo "Failed to clone h5p-php-library"; exit 1; }

RUN cd h5p-php-library && \
    git fetch --unshallow && \
    git checkout $LAST_USED_H5P_LIBRARY || \
    { echo "Failed to checkout commit $LAST_USED_H5P_LIBRARY in h5p-php-library"; exit 1; }

RUN git clone --depth=1 https://github.com/h5p/h5p-editor-php-library.git h5p-editor-php-library || \
    { echo "Failed to clone h5p-editor-php-library"; exit 1; }

RUN cd h5p-editor-php-library && \
    git fetch --unshallow && \
    git checkout $LAST_USED_H5P_EDITOR_LIBRARY || \
    { echo "Failed to checkout commit $LAST_USED_H5P_EDITOR_LIBRARY in h5p-editor-php-library"; exit 1; }
# Disable some elements like "Inhalts-Demo", "Tutorial", "Beispiele" buttons
RUN echo ".h5p-tutorial-url,.h5p-example-url,.h5p-hub-demo-button{visibility:hidden;}" >> h5p-editor-php-library/styles/css/application.css

# Remove unused files
RUN rm h5p-php-library/*.php
RUN rm h5p-editor-php-library/*.php

# Use nginx as server for run stage
FROM docker.io/nginx:1.25

# Copy configuration
COPY nginx.conf /etc/nginx/nginx.conf

# Copy H5P files to webroot
RUN rm -r /usr/share/nginx/html/*
COPY --from=builder --chown=nginx:nginx /h5p-php-library /usr/share/nginx/html/core
COPY --from=builder --chown=nginx:nginx /h5p-editor-php-library /usr/share/nginx/html/editor

# Set up permissions and create required files
RUN chown -R nginx:nginx /var/cache/nginx /etc/nginx && \
    touch /var/run/nginx.pid && \
    chown nginx:nginx /var/run/nginx.pid
USER nginx

EXPOSE 8080
CMD ["nginx", "-g", "daemon off;"]